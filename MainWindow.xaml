<Window x:Class="GraphicsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор" Height="700" Width="1200"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45a049"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel Background="#2b2b2b">
        <!-- Панель инструментов -->
        <StackPanel DockPanel.Dock="Top" Background="#3c3c3c" Orientation="Horizontal" 
                    Height="60">

            <!-- Файловые операции -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Новый файл" Click="NewFile_Click" ToolTip="Ctrl+N"/>
                <Button Content="Открыть" Click="OpenFile_Click"/>
                <Button Content="Сохранить" Click="SaveFile_Click" ToolTip="Ctrl+S"/>
            </StackPanel>

            <Separator Width="2" Background="#555" Margin="5,10"/>

            <!-- Инструменты -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button x:Name="BrushBtn" Content="Кисть" Click="SetBrush_Click" 
                        Background="#2196F3"/>
                <Button x:Name="SelectBtn" Content="Выделение" Click="SetSelect_Click"/>
                <Button x:Name="CropBtn" Content="Обрезка" Click="SetCrop_Click"/>
            </StackPanel>

            <Separator Width="2" Background="#555" Margin="5,10"/>

            <!-- Размер кисти -->
            <StackPanel Orientation="Vertical" Margin="10,5">
                <TextBlock Text="Размер кисти" Foreground="#aaa" FontSize="11"/>
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="BrushSizeSlider" Minimum="1" Maximum="50" Value="5" 
                            Width="100" ValueChanged="BrushSize_Changed"/>
                    <TextBlock x:Name="BrushSizeLabel" Text="5" Foreground="White" 
                               Margin="5,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <Separator Width="2" Background="#555" Margin="5,10"/>

            <!-- Цвета -->
            <StackPanel Orientation="Horizontal" Margin="10,5">
                <Button x:Name="ColorBtn" Width="40" Height="40" 
                        Background="Black" Click="ColorPicker_Click"/>
                <Button Width="30" Height="30" Background="Black" 
                        Click="PresetColor_Click" Tag="#000000"/>
                <Button Width="30" Height="30" Background="Red" 
                        Click="PresetColor_Click" Tag="#FF0000"/>
                <Button Width="30" Height="30" Background="Lime" 
                        Click="PresetColor_Click" Tag="#00FF00"/>
                <Button Width="30" Height="30" Background="Blue" 
                        Click="PresetColor_Click" Tag="#0000FF"/>
                <Button Width="30" Height="30" Background="Yellow" 
                        Click="PresetColor_Click" Tag="#FFFF00"/>
            </StackPanel>

            <Separator Width="2" Background="#555" Margin="5,10"/>

            <!-- Фильтры -->
            <StackPanel Orientation="Vertical" Margin="10,5">
                <TextBlock Text="Фильтры" Foreground="#aaa" FontSize="11"/>
                <ComboBox x:Name="FilterCombo" Width="150" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Выберите фильтр" IsSelected="True"/>
                    <ComboBoxItem Content="Размытие" Tag="blur"/>
                    <ComboBoxItem Content="Ч/Б" Tag="grayscale"/>
                    <ComboBoxItem Content="Негатив" Tag="negative"/>
                    <ComboBoxItem Content="Теплый фильтр" Tag="warm"/>
                    <ComboBoxItem Content="Яркость +30%" Tag="brightness"/>
                    <ComboBoxItem Content="Контрастность" Tag="contrast"/>
                </ComboBox>
            </StackPanel>

            <Separator Width="2" Background="#555" Margin="5,10"/>

            <!-- Поворот -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Повернуть ↻" Click="RotateRight_Click"/>
                <Button Content="Повернуть ↺" Click="RotateLeft_Click"/>
            </StackPanel>

            <Separator Width="2" Background="#555" Margin="5,10"/>

            <!-- Прочее -->
            <StackPanel Orientation="Horizontal" Margin="5">
                <Button Content="Отменить" Click="Undo_Click" ToolTip="Ctrl+Z"/>
                <Button Content="Очистить" Click="Clear_Click" ToolTip="Ctrl+D"/>
            </StackPanel>
        </StackPanel>

        <!-- Статус-бар -->
        <StatusBar DockPanel.Dock="Bottom" Background="#3c3c3c" Height="25">
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="12"
                       Text="Готово | Горячие клавиши: Ctrl+Z, Ctrl+S, Ctrl+D, Ctrl+N"/>
        </StatusBar>

        <!-- Область рисования -->
        <Grid Background="#1a1a1a">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="DrawingCanvas" 
                        Width="800" Height="600" 
                        Background="White"
                        MouseDown="Canvas_MouseDown"
                        MouseMove="Canvas_MouseMove"
                        MouseUp="Canvas_MouseUp"
                        Cursor="Cross"/>
            </ScrollViewer>

            <!-- Рамка выделения -->
            <Border x:Name="SelectionBorder" 
                    BorderBrush="#2196F3" 
                    BorderThickness="2"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <Border.Background>
                    <SolidColorBrush Color="#2196F3" Opacity="0.1"/>
                </Border.Background>
            </Border>
        </Grid>
    </DockPanel>
</Window>