<Window x:Class="PhotoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Editor" Height="700" Width="1200"
        Background="#2d2d2d" KeyDown="Window_KeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#3f3f3f" 
                BorderThickness="0,0,1,0" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Файл -->
                    <TextBlock Text="📁 ФАЙЛ" FontWeight="Bold" FontSize="14" 
                               Foreground="#007acc" Margin="0,0,0,10"/>
                    <Button Content="Открыть (Ctrl+O)" Click="OpenImage_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Сохранить (Ctrl+S)" Click="SaveImage_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Новый холст" Click="NewCanvas_Click" 
                            Style="{StaticResource ToolButton}"/>

                    <Separator Margin="0,15,0,15" Background="#3f3f3f"/>

                    <!-- История -->
                    <TextBlock Text="⏮️ ИСТОРИЯ" FontWeight="Bold" FontSize="14"
                               Foreground="#007acc" Margin="0,0,0,10"/>
                    <Button Content="Отмена (Ctrl+Z)" Click="Undo_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Повтор (Ctrl+Y)" Click="Redo_Click" 
                            Style="{StaticResource ToolButton}"/>

                    <Separator Margin="0,15,0,15" Background="#3f3f3f"/>

                    <!-- Фильтры -->
                    <TextBlock Text="🎨 ФИЛЬТРЫ" FontWeight="Bold" FontSize="14"
                               Foreground="#007acc" Margin="0,0,0,10"/>

                    <TextBlock Text="Яркость:" Foreground="White" Margin="0,5,0,3"/>
                    <Slider x:Name="BrightnessSlider" Minimum="-100" Maximum="100" 
                            Value="0" TickFrequency="10" IsSnapToTickEnabled="True"
                            ValueChanged="BrightnessSlider_ValueChanged"/>
                    <TextBlock Text="{Binding Value, ElementName=BrightnessSlider}" 
                               Foreground="#4ec9b0" HorizontalAlignment="Center"/>

                    <Button Content="Размытие" Click="Blur_Click" 
                            Style="{StaticResource ToolButton}" Margin="0,10,0,0"/>
                    <Button Content="Черно-белый" Click="Grayscale_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Негатив" Click="Invert_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Сепия" Click="Sepia_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Резкость" Click="Sharpen_Click" 
                            Style="{StaticResource ToolButton}"/>

                    <Separator Margin="0,15,0,15" Background="#3f3f3f"/>

                    <!-- Поворот -->
                    <TextBlock Text="🔄 ПОВОРОТ" FontWeight="Bold" FontSize="14"
                               Foreground="#007acc" Margin="0,0,0,10"/>
                    <Button Content="⤺ Влево 90°" Click="RotateLeft_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="⤻ Вправо 90°" Click="RotateRight_Click" 
                            Style="{StaticResource ToolButton}"/>

                    <Separator Margin="0,15,0,15" Background="#3f3f3f"/>

                    <!-- Выделение и Кроп -->
                    <TextBlock Text="🔲 ВЫДЕЛЕНИЕ" FontWeight="Bold" FontSize="14"
                               Foreground="#007acc" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SelectionModeCheck" Content="Режим выделения" 
                              Foreground="White" Margin="0,0,0,10"
                              Checked="SelectionMode_Changed" 
                              Unchecked="SelectionMode_Changed"/>
                    <Button Content="Обрезать выделенное" Click="Crop_Click" 
                            Style="{StaticResource ToolButton}"/>
                    <Button Content="Очистить выделение" Click="ClearSelection_Click" 
                            Style="{StaticResource ToolButton}"/>

                    <Separator Margin="0,15,0,15" Background="#3f3f3f"/>

                    <!-- Рисование -->
                    <TextBlock Text="✏️ РИСОВАНИЕ" FontWeight="Bold" FontSize="14"
                               Foreground="#007acc" Margin="0,0,0,10"/>
                    <CheckBox x:Name="DrawModeCheck" Content="Режим рисования" 
                              Foreground="White" Margin="0,0,0,10"
                              Checked="DrawMode_Changed" 
                              Unchecked="DrawMode_Changed"/>

                    <TextBlock Text="Размер кисти:" Foreground="White" Margin="0,5,0,3"/>
                    <Slider x:Name="BrushSizeSlider" Minimum="1" Maximum="50" 
                            Value="10" TickFrequency="5" IsSnapToTickEnabled="True"/>
                    <TextBlock Text="{Binding Value, ElementName=BrushSizeSlider}" 
                               Foreground="#4ec9b0" HorizontalAlignment="Center"/>

                    <TextBlock Text="Цвет кисти:" Foreground="White" Margin="0,10,0,5"/>
                    <UniformGrid Columns="5" Rows="2">
                        <Button Background="Black" Click="BrushColor_Click" Tag="Black" Style="{StaticResource ColorButton}"/>
                        <Button Background="White" Click="BrushColor_Click" Tag="White" Style="{StaticResource ColorButton}"/>
                        <Button Background="Red" Click="BrushColor_Click" Tag="Red" Style="{StaticResource ColorButton}"/>
                        <Button Background="Green" Click="BrushColor_Click" Tag="Green" Style="{StaticResource ColorButton}"/>
                        <Button Background="Blue" Click="BrushColor_Click" Tag="Blue" Style="{StaticResource ColorButton}"/>
                        <Button Background="Yellow" Click="BrushColor_Click" Tag="Yellow" Style="{StaticResource ColorButton}"/>
                        <Button Background="Orange" Click="BrushColor_Click" Tag="Orange" Style="{StaticResource ColorButton}"/>
                        <Button Background="Purple" Click="BrushColor_Click" Tag="Purple" Style="{StaticResource ColorButton}"/>
                        <Button Background="Pink" Click="BrushColor_Click" Tag="Pink" Style="{StaticResource ColorButton}"/>
                        <Button Background="Brown" Click="BrushColor_Click" Tag="Brown" Style="{StaticResource ColorButton}"/>
                    </UniformGrid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Область изображения -->
        <Border Grid.Column="1" Background="#2d2d2d">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image x:Name="MainImage" Stretch="Uniform" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           MouseLeftButtonDown="Image_MouseDown"
                           MouseMove="Image_MouseMove"
                           MouseLeftButtonUp="Image_MouseUp"/>
                    <Canvas x:Name="SelectionCanvas" Background="Transparent"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                        <Rectangle x:Name="SelectionRect" 
                                   Stroke="Yellow" StrokeThickness="2" 
                                   StrokeDashArray="4 2" 
                                   Visibility="Collapsed"/>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>

    <Window.Resources>
        <!-- Стили кнопок -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#007acc"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#005a9e"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColorButton" TargetType="Button">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#3f3f3f"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="Yellow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
</Window>