<Window x:Class="GraphicsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GraphicsEditor"
        xmlns:vm="clr-namespace:GraphicsEditor.ViewModels"
        mc:Ignorable="d"
        Title="Graphics Editor" Height="600" Width="800">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Command="{Binding AddImageCommand}" ToolTip="Добавить изображение">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Добавить" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding RotateImageCommand}" ToolTip="Повернуть изображение">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Повернуть" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding BrushCommand}" ToolTip="Кисть">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖌️" FontSize="14"/>
                    <TextBlock Text="Кисть" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Button Command="{Binding EraserCommand}" ToolTip="Ластик">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🧹" FontSize="14"/>
                    <TextBlock Text="Ластик" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>

            <Separator/>

            <Button Command="{Binding SelectColorCommand}" CommandParameter="Red" ToolTip="Красный">
                <Rectangle Fill="Red" Width="20" Height="20"/>
            </Button>

            <Button Command="{Binding SelectColorCommand}" CommandParameter="Blue" ToolTip="Синий">
                <Rectangle Fill="Blue" Width="20" Height="20"/>
            </Button>

            <Button Command="{Binding SelectColorCommand}" CommandParameter="Green" ToolTip="Зеленый">
                <Rectangle Fill="Green" Width="20" Height="20"/>
            </Button>

            <Button Command="{Binding SelectColorCommand}" CommandParameter="Yellow" ToolTip="Желтый">
                <Rectangle Fill="Yellow" Width="20" Height="20"/>
            </Button>

            <Button Command="{Binding SelectColorCommand}" CommandParameter="Purple" ToolTip="Фиолетовый">
                <Rectangle Fill="Purple" Width="20" Height="20"/>
            </Button>

            <Separator/>

            <TextBlock Text="Размер:" VerticalAlignment="Center"/>
            <Slider Value="{Binding BrushSize}" 
                    Minimum="1" 
                    Maximum="20" 
                    Width="100"/>
            <TextBlock Text="{Binding BrushSize, StringFormat={}{0:F0}}"/>
        </ToolBar>

        <ScrollViewer Grid.Row="1" 
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto">

            <InkCanvas x:Name="MainInkCanvas"
                       Background="White" 
                       Width="{Binding CanvasWidth}" 
                       Height="{Binding CanvasHeight}">

                <Image Source="{Binding CurrentImage.ImageSource}" 
                       Width="{Binding CurrentImage.Width}" 
                       Height="{Binding CurrentImage.Height}"
                       RenderTransformOrigin="0.5,0.5">
                    
                    <Image.RenderTransform>
                        <RotateTransform Angle="{Binding CurrentImage.Angle}"/>
                    </Image.RenderTransform>
                </Image>

            </InkCanvas>
        </ScrollViewer>
    </Grid>
</Window>