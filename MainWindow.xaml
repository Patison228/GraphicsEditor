<Window x:Class="GraphicsEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GraphicsEditor"
        mc:Ignorable="d"
        Title="Graphics Editor" Height="600" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar>
            <Button Content="Add image"
                    Command="{Binding AddImageCommand}"
                    Margin="5"/>

            <Button Content="Save"
                    Margin="5"/>

            <Button Content="Rot right"
                    Command="{Binding RotateImageCommand}"
                    Margin="5"/>
        </ToolBar>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <InkCanvas Background="White" Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}">
                <Image Source="{Binding CurrentImage.ImageSource}" 
                       Width="{Binding CurrentImage.Width}" 
                       Height="{Binding CurrentImage.Height}"
                       Canvas.Left="20"
                       Canvas.Top="20"
                       Canvas.Right="20"
                       Canvas.Bottom="20"
                       RenderTransformOrigin="0.5,0.5">

                    <Image.RenderTransform>
                        <TransformGroup>
                            <RotateTransform Angle="{Binding CurrentImage.Angle}"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
                
            </InkCanvas>
        </ScrollViewer>
    </Grid>
</Window>